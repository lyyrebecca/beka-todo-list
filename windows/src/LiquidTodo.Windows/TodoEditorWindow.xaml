<Window x:Class="LiquidTodo.Windows.TodoEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="待办" Width="440" Height="550" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource Surface}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="74"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock x:Name="TitleText" Text="新建待办" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
  <TextBox x:Name="TodoTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10" FontSize="15" Margin="0,12,0,8"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6"><TextBlock Text="重要级别" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryInk}"/><ComboBox x:Name="PriorityInput" Width="250"><ComboBoxItem Tag="Normal" Content="普通"/><ComboBoxItem Tag="Important" Content="重要 🌟"/><ComboBoxItem Tag="Urgent" Content="紧急 ‼️"/></ComboBox></StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6"><TextBlock Text="时间模式" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryInk}"/><ComboBox x:Name="ModeInput" Width="250" SelectionChanged="ModeInput_SelectionChanged"><ComboBoxItem Tag="None" Content="无时间"/><ComboBoxItem Tag="Deadline" Content="截止日期"/><ComboBoxItem Tag="Day" Content="某一天"/><ComboBoxItem Tag="Period" Content="期间"/></ComboBox></StackPanel>
  <StackPanel Grid.Row="4" x:Name="DateRow" Orientation="Horizontal" Margin="0,6"><TextBlock x:Name="DateLabel" Text="日期和时间" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryInk}"/><DatePicker x:Name="DateInput" Width="142"/><TextBox x:Name="TimeInput" Width="82" Margin="8,0,0,0" ToolTip="24 小时制，例如 21:00"/></StackPanel>
  <StackPanel Grid.Row="5" x:Name="PeriodRow" Orientation="Horizontal" Margin="0,6" Visibility="Collapsed"><TextBlock Text="起止日期" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryInk}"/><DatePicker x:Name="StartInput" Width="120"/><TextBlock Text="至" Margin="7,0" VerticalAlignment="Center"/><DatePicker x:Name="EndInput" Width="120"/></StackPanel>
  <StackPanel Grid.Row="6" x:Name="ReminderRow" Orientation="Horizontal" Margin="0,6"><TextBlock Text="提醒方式" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryInk}"/><ComboBox x:Name="ReminderInput" Width="250" SelectionChanged="ReminderInput_SelectionChanged"><ComboBoxItem Tag="None" Content="不提醒"/><ComboBoxItem Tag="AtTime" Content="到时提醒"/><ComboBoxItem Tag="DayBefore" Content="提前一天"/><ComboBoxItem Tag="DailyDuringPeriod" Content="期间内每天"/></ComboBox></StackPanel>
  <StackPanel Grid.Row="7" x:Name="ReminderTimeRow" Orientation="Horizontal" Margin="0,6" Visibility="Collapsed"><TextBlock x:Name="ReminderTimeLabel" Text="提醒时间" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryInk}"/><TextBox x:Name="ReminderTimeInput" Width="82" ToolTip="24 小时制，例如 21:00"/></StackPanel>
  <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20,0,0"><Button Content="取消" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="保存" Width="92" Background="{DynamicResource Purple}" Foreground="White" BorderThickness="0" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>
