<Window x:Class="LiquidTodo.Windows.NameSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="欢迎使用" Width="390" Height="260" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource Surface}">
 <StackPanel Margin="28"><TextBlock Text="给你的 Todo list 取个名字" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/><TextBlock Text="默认是「贝卡の Todo list」。填写名字后会显示为「你的名字の Todo list」，以后也可随时修改。" TextWrapping="Wrap" Margin="0,12,0,14" Foreground="{DynamicResource SecondaryInk}"/><TextBox x:Name="NameInput" FontSize="15" Padding="8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="使用默认" Width="88" Margin="0,0,8,0" Click="Default_Click"/><Button Content="保存" Width="78" Background="{DynamicResource Purple}" Foreground="White" BorderThickness="0" Click="Save_Click"/></StackPanel></StackPanel>
</Window>
